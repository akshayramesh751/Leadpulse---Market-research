# ==============================================================================
# Autonomous Lead Enrichment Agent - Environment Configuration
# ==============================================================================

# LLM Provider Configuration (Groq)
# Recommended models: "openai/gpt-oss-120b", "openai/gpt-oss-20b", "llama-3.3-70b-versatile"
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Fetch Layer & Browser Settings
# Politeness limit: concurrent pages/domains open in Playwright
MAX_CONCURRENCY=3

# Page navigation timeout in milliseconds
REQUEST_TIMEOUT_MS=30000

# Subpage Discovery Settings
# Max high-signal subpages to crawl per domain (bounds latency and tokens)
MAX_PAGES_PER_DOMAIN=5

# Content Cleaning & Token Budgeting
# Max estimated token budget per company context fed to LLM
MAX_TOKENS_PER_DOMAIN=6000

# Optional Search Fallback (Phase 7 Bonus)
# If provided, enables LinkedIn profile lookups for key leadership
SERPAPI_KEY=
TAVILY_API_KEY=

# Output & Logging
LOG_LEVEL=INFO
LOG_FILE=logs/run.log
